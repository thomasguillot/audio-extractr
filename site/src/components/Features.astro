---
import Section from "./Section.astro";

const features = [
  {
    title: "Paste a link or drop a file",
    body: "Pulls the audio from most video and audio links with yt-dlp, or takes any file ffmpeg can read.",
  },
  {
    title: "Trim on the waveform",
    body: "Drag the handles to keep just the part you want. They snap to the playhead, and Space plays and pauses the preview.",
  },
  {
    title: "Speed",
    body: "0.25× to 2× in fine steps, pitch preserved. Preview it before you save.",
  },
  {
    title: "MP3 out",
    body: "Clean 192 kbps MP3, saved to the folder you choose. Names never clash.",
  },
  {
    title: "Transcript (experimental)",
    body: "Check the box before extracting and the text lands beside the MP3, as Markdown or plain text. It runs on your Mac, so nothing is uploaded.",
  },
  {
    title: "Self-updating",
    body: "Updates itself from GitHub Releases and keeps yt-dlp current, so upstream changes don't break your downloads.",
  },
];
---

<Section
  id="features"
  title="What it does"
  lede="One small window that does the whole job: paste or drop, trim, set the speed, and save."
>
  <ul class="features grid span-all" role="list">
    {
      features.map((feature) => (
        <li class="span-half">
          <h3 class="title">{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .features {
    --row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .features li {
    max-width: none;
    border-top: 1px solid var(--line);
    padding: var(--col-gap) 0;
  }

  .features li:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 900px) {
    .features li:nth-last-child(2):nth-child(odd) {
      padding-bottom: 0;
    }
  }

  h3 {
    margin-bottom: 1rem;
  }

  p {
    color: var(--muted);
  }
</style>
