---
import Section from "./Section.astro";

const features = [
  {
    title: "Links and files",
    body: "Pulls the audio from most video and audio links with yt-dlp, or takes any file ffmpeg can read.",
  },
  {
    title: "Trim on the waveform",
    body: "The handles snap to the playhead, and Space plays and pauses the preview.",
  },
  {
    title: "Speed",
    body: "0.25× to 2× in fine steps, pitch preserved. Preview it before you save.",
  },
  {
    title: "MP3 out",
    body: "Clean 192 kbps MP3, saved to your Downloads folder or wherever you point it.",
  },
  {
    title: "Transcript (experimental)",
    body: "Off by default. Turn it on before extracting and you get Markdown or plain text next to the audio, written on your Mac.",
  },
  {
    title: "Self-updating",
    body: "Updates itself from GitHub Releases and keeps yt-dlp current, so it keeps working when sites change.",
  },
];
---

<Section
  id="features"
  title="What it does"
  lede="A short list on purpose. The app has one job, and everything it needs sits in one window."
>
  <ul class="features rule-rows grid span-all" role="list">
    {
      features.map((feature) => (
        <li class="span-half">
          <h3 class="title">{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .features {
    --row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    .features li:nth-last-child(2):nth-child(odd) {
      padding-bottom: 0;
    }
  }

  h3 {
    margin-bottom: 1rem;
  }

  p {
    color: var(--muted);
  }
</style>
