---
interface Props {
  id: string;
  title: string;
  lede: string;
}

const { id, title, lede } = Astro.props;
---

<section id={id} class="panel-section" data-reveal aria-labelledby={`${id}-title`}>
  <div class="shell">
    <div class="panel grid">
      <div class="span-head">
        <h2 id={`${id}-title`}>{title}</h2>
        <p class="lede">{lede}</p>
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .panel-section {
    padding-top: var(--section);
  }

  .panel {
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .lede {
    margin-top: 1rem;
  }
</style>
