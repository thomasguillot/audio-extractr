---
import Section from "./Section.astro";

const steps = [
  {
    title: "Paste a link or drop a file",
    body: "Paste a link from almost any video or audio site and the audio is fetched for you. Or drop any file straight onto the window.",
  },
  {
    title: "Edit and transcribe",
    body: "Drag the handles on the waveform to keep the part you want, then set the speed and preview it. Check the box to save a transcript (experimental).",
  },
  {
    title: "Save as MP3",
    body: "One click writes a clean MP3 to your folder. No save dialog, nothing overwritten.",
  },
] as const;
---

<Section
  id="how"
  title="How it works"
  lede="Three steps from a link or a file to an MP3 on disk, with nothing to configure before you start."
>
  <ol class="steps grid span-all" role="list">
    {
      steps.map((step, index) => (
        <li class="step">
          <span class="num">{index + 1}</span>
          <h3 class="title">{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    grid-column: span 4;
    max-width: none;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  @media (max-width: 899px) {
    .step {
      grid-column: 1 / -1;
    }
  }

  .num {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--link);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.9vw, 1.625rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.008em;
    font-variant-numeric: tabular-nums;
  }

  .title {
    margin-bottom: 0.75rem;
  }

  p {
    color: var(--muted);
  }
</style>
