---
import DownloadButton from "./DownloadButton.astro";
import Panel from "./Panel.astro";
import { version } from "../site";

const spec = [
  ...(version ? [{ term: "Version", value: version }] : []),
  { term: "License", value: "MIT" },
  { term: "Requires", value: "macOS 26 or later" },
  { term: "Architecture", value: "Apple silicon" },
];
---

<Panel
  id="privacy"
  title="Your audio never leaves your Mac."
  lede="Trimming, encoding, and transcription all happen on your machine, with no account and no analytics. The only network traffic is the link you paste, the update checks on GitHub for the app and yt-dlp, and the speech model Apple downloads the first time you transcribe in a new language."
>
  <div class="span-body">
    <dl class="spec">
      {
        spec.map((row) => (
          <div class="spec-row">
            <dt>{row.term}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <DownloadButton />
  </div>
</Panel>

<style>
  .span-body {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: space-between;
  }

  .spec {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .span-body :global(.btn) {
    align-self: flex-start;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--line-strong);
    padding-block: 0.75rem;
  }

  .spec-row dt {
    color: var(--muted);
  }

  .spec-row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
