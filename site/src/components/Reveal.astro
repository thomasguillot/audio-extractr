<script>
  import { animate, inView } from "motion";
  import { SPRING_CRISP, prefersReducedMotion } from "../motion";

  const FROM = "translateY(14px) scale(1)";
  const SETTLED = "translateY(0px) scale(1)";
  const MARGIN = "0px 0px -10% 0px";

  function reveal(selector: string, stagger = 0) {
    document.querySelectorAll<HTMLElement>(selector).forEach((trigger) => {
      if (trigger.getBoundingClientRect().top < window.innerHeight * 0.9) return;

      const items = stagger
        ? Array.from(trigger.querySelectorAll<HTMLElement>(":scope > *"))
        : [trigger];

      items.forEach((item) => {
        item.style.opacity = "0";
        item.style.transform = FROM;
      });

      const stop = inView(
        trigger,
        () => {
          stop();
          items.forEach((item, index) => {
            animate(
              item,
              { opacity: 1, transform: SETTLED },
              { ...SPRING_CRISP, delay: index * stagger },
            );
          });
        },
        { margin: MARGIN },
      );
    });
  }

  if (!prefersReducedMotion()) {
    reveal("[data-reveal]");
    reveal("[data-reveal-stagger]", 0.05);
  }
</script>
