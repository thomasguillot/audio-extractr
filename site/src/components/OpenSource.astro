---
import Section from "./Section.astro";

const points = [
  {
    title: "MIT-licensed",
    body: "The whole app, every commit, is on GitHub under the MIT license. Read it, fork it, build it.",
    links: [{ label: "Source on GitHub", href: "https://github.com/thomasguillot/audio-extractr" }],
  },
  {
    title: "No telemetry",
    body: "No analytics and no crash reporting. Everything the app sends is listed below.",
    links: [{ label: "What it sends", href: "#privacy" }],
  },
  {
    title: "Built on open tools",
    body: "yt-dlp fetches, ffmpeg decodes and encodes. Both run as separate processes, never linked into the app, and both are credited in the acknowledgements.",
    links: [
      { label: "yt-dlp", href: "https://github.com/yt-dlp/yt-dlp" },
      { label: "FFmpeg", href: "https://ffmpeg.org" },
      {
        label: "Acknowledgements",
        href: "https://github.com/thomasguillot/audio-extractr/blob/main/ACKNOWLEDGEMENTS.md",
      },
    ],
  },
  {
    title: "No Developer Program",
    body: "It ships unsigned rather than behind a paid Apple membership.",
    links: [{ label: "How to install", href: "#install" }],
  },
];
---

<Section
  id="open-source"
  title="Free and open source."
  lede="Nothing to buy and nothing to sign up for."
>
  <ul class="points grid span-all" role="list">
    {
      points.map((point) => (
        <li class="span-half">
          <h3 class="title">{point.title}</h3>
          <p>{point.body}</p>
          {point.links.length > 0 && (
            <p class="links">
              {point.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .points {
    --row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .points li {
    max-width: none;
    border-top: 1px solid var(--line);
    padding: var(--col-gap) 0;
  }

  .points li:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 900px) {
    .points li:nth-last-child(2):nth-child(odd) {
      padding-bottom: 0;
    }
  }

  h3 {
    margin-bottom: 1rem;
  }

  p {
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 10px;
    font-weight: 600;
  }
</style>
