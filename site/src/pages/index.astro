---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import OpenSource from "../components/OpenSource.astro";
import Install from "../components/Install.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
---

<Base
  title="Audio Extractr, turn any video into an MP3"
  description="A free, open-source macOS app that turns any video into an MP3: paste a link or drop a file, trim it, set the speed, and save it to disk, plus a transcript if you want one."
>
  <main id="main" tabindex="-1">
    <Hero />
    <HowItWorks />
    <Features />
    <OpenSource />
    <Install />
    <Faq />
    <Closing />
  </main>
  <Footer />
  <Reveal />
</Base>
